<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Encuestas de Ayuda</title>
    <link rel="stylesheet" href="/css/asistencia.css">
    <link rel="stylesheet" href="/css/adminTheme.css">
</head>
<body>

<button class="theme-btn" onclick="toggleTheme()">🌙</button>

<div class="container">

    <h2>Encuestas de Ayuda</h2>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>Opinión</th>
                    <th>Puntuación</th>
                    <th>Promos</th>
                    <th>Imagen</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
                <% encuestas.forEach(encuesta => { %>
                    <tr>
                        <td><%= encuesta.id %></td>
                        <td><%= encuesta.email %></td>
                        <td><%= encuesta.opinion %></td>
                        <td>
                            <span class="badge">
                                <%= encuesta.puntuacion %>
                            </span>
                        </td>
                        <td>
                            <span class="<%= encuesta.acepta_promos ? 'yes' : 'no' %>">
                                <%= encuesta.acepta_promos ? "Sí" : "No" %>
                            </span>
                        </td>
                        <td>
                            <% if (encuesta.imagen) { %>
                                <img src="/uploads/<%= encuesta.imagen %>" class="mini-img">
                            <% } else { %>
                                <span class="no-img">Sin imagen</span>
                            <% } %>
                        </td>
                        <td><%= encuesta.createdAt.toLocaleString() %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

    <div class="buttons">
        <a href="/admin/dashboard" class="btn">Volver al Dashboard</a>
    </div>

</div>

<script>
function toggleTheme() {
    document.body.classList.toggle("dark");
    localStorage.setItem("adminTema", document.body.classList.contains("dark") ? "dark" : "light");
}
if (localStorage.getItem("adminTema") === "dark") {
    document.body.classList.add("dark");
}
</script>

</body>
</html>
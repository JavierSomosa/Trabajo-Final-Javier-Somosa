<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Admin</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/adminTheme.css">
</head>
<body>

<button class="theme-btn" onclick="toggleTheme()">🌙</button>

<header class="topbar">
    <div>
        <h1>🎮 Zona Gamer - Admin</h1>
        <span style="font-size:12px;color:#94a3b8;">Javier Somosa</span>
    </div>
    <nav>
        <a href="/admin/dashboard" style="color:white;margin-right:15px;text-decoration:none;">Dashboard</a>
        <a href="/admin/registros" style="color:white;margin-right:15px;text-decoration:none;">Registros</a>
        <a href="/admin/asistencia" style="color:white;margin-right:15px;text-decoration:none;">Encuestas</a>
        <a href="/admin/logout" class="logout">Cerrar sesión</a>
    </nav>
</header>

<section class="actions">
    <a href="/admin/productos/nuevo" class="btn primary">Crear Producto</a>
    <a href="/admin/registros" class="btn">Ver Registros</a>
    <a href="/admin/asistencia" class="btn">Ver Encuestas</a>
</section>

<section class="tabla-container">
    <h2>🎮 Juegos</h2>

    <table>
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Imagen</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% productos.filter(p => p.categoria === "Juego").forEach(producto => { %>
                <tr>
                    <td><%= producto.nombre %></td>
                    <td>$ <%= producto.precio %></td>
                    <td>
                        <% if (producto.imagen) { %>
                            <img src="/uploads/<%= producto.imagen %>">
                        <% } else { %>
                            Sin imagen
                        <% } %>
                    </td>
                    <td>
                        <% if (producto.activo) { %>
                            <span class="activo">Activo</span>
                        <% } else { %>
                            <span class="inactivo">Inactivo</span>
                        <% } %>
                    </td>
                    <td class="acciones">

                        <a href="/admin/productos/<%= producto.id %>/editar" class="btn small">
                            Editar
                        </a>

                        <% if (producto.activo) { %>
                            <form action="/admin/productos/<%= producto.id %>/eliminar"
                                method="POST"
                                onsubmit="return confirmarEliminacion();">
                                <button class="btn danger small">Desactivar</button>
                            </form>
                        <% } %>

                        <% if (!producto.activo) { %>
                            <form action="/admin/productos/<%= producto.id %>/activar"
                                method="POST"
                                onsubmit="return confirmarActivacion();">
                                <button class="btn success small">Activar</button>
                            </form>
                        <% } %>

                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</section>

<section class="tabla-container">
    <h2>🎬 Películas</h2>

    <table>
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Imagen</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% productos.filter(p => p.categoria === "Película").forEach(producto => { %>
                <tr>
                    <td><%= producto.nombre %></td>
                    <td>$ <%= producto.precio %></td>
                    <td>
                        <% if (producto.imagen) { %>
                            <img src="/uploads/<%= producto.imagen %>">
                        <% } else { %>
                            Sin imagen
                        <% } %>
                    </td>
                    <td>
                        <% if (producto.activo) { %>
                            <span class="activo">Activo</span>
                        <% } else { %>
                            <span class="inactivo">Inactivo</span>
                        <% } %>
                    </td>
                    <td class="acciones">

                        <a href="/admin/productos/<%= producto.id %>/editar" class="btn small">
                            Editar
                        </a>

                        <% if (producto.activo) { %>
                            <form action="/admin/productos/<%= producto.id %>/eliminar"
                                method="POST"
                                onsubmit="return confirmarEliminacion();">
                                <button class="btn danger small">Desactivar</button>
                            </form>
                        <% } %>

                        <% if (!producto.activo) { %>
                            <form action="/admin/productos/<%= producto.id %>/activar"
                                method="POST"
                                onsubmit="return confirmarActivacion();">
                                <button class="btn success small">Activar</button>
                            </form>
                        <% } %>

                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</section>

<!-- modal -->
<div id="modalConfirmar" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:999;justify-content:center;align-items:center;">
    <div style="background:white;padding:25px;border-radius:12px;text-align:center;max-width:350px;margin:auto;margin-top:20vh;">
        <p id="modalTexto" style="margin-bottom:15px;font-size:16px;"></p>
        <button id="modalSi" class="btn danger small" style="margin-right:10px;">Sí</button>
        <button id="modalNo" class="btn small">Cancelar</button>
    </div>
</div>

<script>
let formPendiente = null;

function mostrarModal(texto, form) {
    formPendiente = form;
    document.getElementById("modalTexto").textContent = texto;
    document.getElementById("modalConfirmar").style.display = "flex";
}

document.getElementById("modalSi").addEventListener("click", function() {
    document.getElementById("modalConfirmar").style.display = "none";
    if (formPendiente) formPendiente.submit();
});

document.getElementById("modalNo").addEventListener("click", function() {
    document.getElementById("modalConfirmar").style.display = "none";
    formPendiente = null;
});

function confirmarEliminacion(e) {
    e.preventDefault();
    mostrarModal("¿Estás seguro de desactivar este producto?", e.target);
}
function confirmarActivacion(e) {
    e.preventDefault();
    mostrarModal("¿Estás seguro de activar este producto?", e.target);
}
function toggleTheme() {
    document.body.classList.toggle("dark");
    localStorage.setItem("adminTema", document.body.classList.contains("dark") ? "dark" : "light");
}
if (localStorage.getItem("adminTema") === "dark") {
    document.body.classList.add("dark");
}

document.querySelectorAll("form[onsubmit]").forEach(function(form) {
    var original = form.getAttribute("onsubmit");
    form.removeAttribute("onsubmit");
    if (original.includes("confirmarEliminacion")) {
        form.addEventListener("submit", confirmarEliminacion);
    } else if (original.includes("confirmarActivacion")) {
        form.addEventListener("submit", confirmarActivacion);
    }
});
</script>

</body>
</html>